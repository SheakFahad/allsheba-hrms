# ---------------------------------------------------------------------------
# ALL SHEBA HRMS — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, add these in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used for user administration, provisioning and the cron job.
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal login domain: usernames are mapped to <username>@<domain> in Supabase Auth.
# Any domain you control or a non-routable one; it is never shown to users.
AUTH_EMAIL_DOMAIN=hrms.allsheba.local

# Initial passwords — used ONLY by `npm run provision` (one-time account setup).
# Users are forced to change them at first login. Remove them after provisioning.
ADMIN_INITIAL_PASSWORD=
ENTRY_INITIAL_PASSWORD=

# Secret for the Vercel cron endpoint /api/cron/close-attendance (any long random string)
CRON_SECRET=
